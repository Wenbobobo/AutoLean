#!/bin/sh
set -eu

fail() {
  printf '%s\n' "autolean-lean-wrapper: $1" >&2
  exit 2
}

[ "$#" -eq 8 ] || fail "expected the frozen wrapper argument profile"
[ "$1" = "--protocol" ] || fail "missing protocol argument"
[ "$2" = "autolean.oci-lean-wrapper.v1" ] || fail "unsupported protocol"
[ "$3" = "--candidate" ] || fail "missing candidate argument"
[ "$4" = "/input/Candidate.lean" ] || fail "candidate path is not frozen"
[ "$5" = "--declaration" ] || fail "missing declaration argument"
declaration=$6
[ "$7" = "--type-format" ] || fail "missing type-format argument"
[ "$8" = "autolean.lean-pp-expr.v1" ] || fail "unsupported type format"

case "$declaration" in
  ""|*[!A-Za-z0-9_.]*) fail "declaration uses unsupported characters" ;;
  .*|*..*|*.) fail "declaration is not a canonical dotted name" ;;
esac

candidate=/input/Candidate.lean
[ -f "$candidate" ] || fail "candidate is unavailable"
[ ! -L "$candidate" ] || fail "candidate must not be a symbolic link"

scratch=$(mktemp -d /tmp/autolean-lean-wrapper.XXXXXX)
cleanup() {
  rm -rf "$scratch"
}
trap cleanup EXIT HUP INT TERM

# Candidate diagnostics never share the wrapper's stdout. In particular, #eval output cannot
# manufacture a wrapper JSON record. The environment query runs only after kernel elaboration.
if ! LEAN_PATH=/opt/lean/lib/lean lean \
  -R /input \
  -o "$scratch/Candidate.olean" \
  "$candidate" \
  >"$scratch/compiler.stdout" 2>"$scratch/compiler.stderr"
then
  sed -n '1,200p' "$scratch/compiler.stderr" >&2
  exit 20
fi

if ! LEAN_PATH="$scratch:/opt/lean/lib/lean" lean --run \
  /opt/autolean/lib/AutoleanLeanQuery.lean \
  "$declaration" \
  >"$scratch/query.stdout" 2>"$scratch/query.stderr"
then
  sed -n '1,200p' "$scratch/query.stderr" >&2
  exit 21
fi

# The helper is image-owned. The host parser independently requires one canonical JSON object with
# the exact schema and environment bindings; wrapper stdout contains no candidate diagnostics.
result_lines=$(wc -l <"$scratch/query.stdout")
[ "$result_lines" -eq 1 ] || fail "query helper did not emit exactly one record"
cat "$scratch/query.stdout"
