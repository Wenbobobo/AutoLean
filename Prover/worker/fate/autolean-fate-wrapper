#!/bin/sh
set -eu

fail() {
  printf '%s\n' "autolean-fate-wrapper: $1" >&2
  exit 2
}

[ "$#" -ge 4 ] || fail "expected the frozen wrapper argument profile"
[ "$1" = "--protocol" ] || fail "missing protocol argument"
[ "$2" = "autolean.fate-oci-lean-wrapper.v2" ] || fail "unsupported protocol"
[ "$3" = "--phase" ] || fail "missing phase argument"
phase=$4
helper=/verifier/AutoleanFateQuery.lean
[ -f "$helper" ] || fail "query helper is unavailable"
[ ! -L "$helper" ] || fail "query helper must not be a symbolic link"

lean_path="/deps/packages/Cli/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/batteries/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/Qq/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/aesop/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/proofwidgets/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/importGraph/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/LeanSearchClient/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/plausible/.lake/build/lib/lean"
lean_path="$lean_path:/deps/packages/mathlib/.lake/build/lib/lean"
lean_path="$lean_path:/opt/lean/lib/lean"

scratch=$(mktemp -d /tmp/autolean-fate-wrapper.XXXXXX)
cleanup() {
  rm -rf "$scratch"
}
trap cleanup EXIT HUP INT TERM

case "$phase" in
  compile)
    [ "$#" -eq 8 ] || fail "expected the frozen compile argument profile"
    [ "$5" = "--candidate" ] || fail "missing candidate argument"
    [ "$6" = "/input/Candidate.lean" ] || fail "candidate path is not frozen"
    [ "$7" = "--output" ] || fail "missing output argument"
    [ "$8" = "/output/Candidate.olean" ] || fail "compiled output path is not frozen"
    candidate=/input/Candidate.lean
    [ -f "$candidate" ] || fail "candidate is unavailable"
    [ ! -L "$candidate" ] || fail "candidate must not be a symbolic link"
    [ -d /output ] || fail "compiled output directory is unavailable"
    [ ! -L /output ] || fail "compiled output directory must not be a symbolic link"
    if ! LEAN_PATH="$lean_path" lean \
      -R /input \
      -o /output/Candidate.olean \
      "$candidate" \
      >"$scratch/compiler.stdout" 2>"$scratch/compiler.stderr"
    then
      sed -n '1,200p' "$scratch/compiler.stderr" >&2
      exit 20
    fi
    ;;
  query)
    [ "$#" -eq 10 ] || fail "expected the frozen query argument profile"
    [ "$5" = "--compiled" ] || fail "missing compiled candidate argument"
    [ "$6" = "/compiled/Candidate.olean" ] || fail "compiled candidate path is not frozen"
    [ "$7" = "--declaration" ] || fail "missing declaration argument"
    declaration=$8
    [ "$9" = "--type-format" ] || fail "missing type-format argument"
    [ "${10}" = "autolean.lean-pp-expr.v1" ] || fail "unsupported type format"
    case "$declaration" in
      ""|*[!A-Za-z0-9_.]*) fail "declaration uses unsupported characters" ;;
      .*|*..*|*.) fail "declaration is not a canonical dotted name" ;;
    esac
    [ -f /compiled/Candidate.olean ] || fail "compiled candidate is unavailable"
    [ ! -L /compiled/Candidate.olean ] || fail "compiled candidate must not be a symbolic link"
    if ! LEAN_PATH="$lean_path:/compiled" lean --run \
      "$helper" \
      "$declaration" \
      >"$scratch/query.stdout" 2>"$scratch/query.stderr"
    then
      sed -n '1,200p' "$scratch/query.stderr" >&2
      exit 21
    fi
    result_lines=$(wc -l <"$scratch/query.stdout")
    [ "$result_lines" -eq 1 ] || fail "query helper did not emit exactly one record"
    cat "$scratch/query.stdout"
    ;;
  *)
    fail "unsupported phase"
    ;;
esac
